#!/usr/bin/env bash
# pre-commit —— 【改完即重生】：闸门资产一变，就自动重生 INDEX / 引擎清单 / 资产基线。
#
# ★ 为什么存在（reviewer ③ · 2026-10-11）：一致性检查在 CI 层（事后），而 pre-commit 层是空的
#   ⇒ 同一个坑踩了两次。**同坑两次不是粗心，是位置错** ⇒ 防线前移到事前：不依赖"记得"，改完即重生。
#
# ★ 2026-10-12 重写（园丁裁定 0）：原版有三处控制流病，导致**新增的阻断是不可达的死代码**：
#   ① 第 9 行 `cd … ||` 后面接了注释与 if ⇒ **`||` 短路掉整块 wip 判断**（永不执行）；
#   ② 第 26 行**无条件 `exit 0`** ⇒ 其后的重生/阻断**全是死代码**（"死判据"家族第 9 例）；
#   ③ 其后一个 `if/else` 缺 `fi`。
#   ⇒ 现在：**无早退、无死代码**；逃生门（[wip]）只跳【扫描】、**保留【重生】**。
set -uo pipefail
ROOT=$(git rev-parse --show-toplevel) || { echo "⛔ 不在 git 工作区 ⇒ 拒绝提交" >&2; exit 1; }
cd "$ROOT" || exit 1

WIP=0
LASTMSG=$(git log -1 --pretty=%s 2>/dev/null || true)
case "$LASTMSG" in *'[wip]'*) WIP=1 ;; esac

# ── ① 扫描（timing:post）· 仅非 [wip]（[wip] 的逃生门只跳这一步）────────────────
if [ "$WIP" = 0 ]; then
  viol=0
  for f in $(git diff --cached --name-only | grep -E '\.(md|sh|py|ya?ml)$' || true); do
    [ -f "$f" ] || continue
    printf '{"tool":"Write","paths":["%s"]}\n' "$f" | bash tools/validate.sh --timing post > /tmp/.hookscan.$$ 2>&1
    if [ $? = 2 ]; then grep -m1 '违规' /tmp/.hookscan.$$ | sed 's/^/  ★ 违规: /'; viol=1; fi
  done
  rm -f /tmp/.hookscan.$$
  if [ "$viol" = 1 ]; then echo "  ⇒ step 4 扫描有违规 ⇒ 拒绝提交（防线前移到事前）" >&2; exit 1; fi
else
  echo "  [pre-commit] 提交信息含 [wip] ⇒ 跳过 step-4 扫描（**仍重生** INDEX/清单/基线；CI 兜底）"
fi

# ── ② 重生（**[wip] 也要做**）· 任何一步失败 ⇒ 阻断（把红挡在本机）─────────────
idx_out=$(bash tools/validate.sh --index 2>&1); idx_rc=$?
if [ "$idx_rc" != 0 ]; then echo "⛔ INDEX 重生失败 ⇒ 拒绝提交: $(printf '%s' "$idx_out" | tail -1)" >&2; exit 1; fi
if ! printf '%s' "$idx_out" | cmp -s - decisions/INDEX.md 2>/dev/null; then
  printf '%s' "$idx_out" > decisions/INDEX.md; git add decisions/INDEX.md
  echo "  [pre-commit] 闸门资产变了 ⇒ decisions/INDEX.md 已自动重生（不依赖记得）"
fi

staged=$(git diff --cached --name-only 2>/dev/null | grep -E '^(decisions/|tools/|DNA\.md)' || true)
if [ -n "$staged" ]; then
  um_out=$(bash tools/upstream-manifest.sh --write 2>&1); um_rc=$?
  if [ "$um_rc" != 0 ]; then echo "⛔ 引擎清单重生失败 ⇒ 拒绝提交: $(printf '%s' "$um_out" | tail -1)" >&2; exit 1; fi
  git add tools/upstream-manifest.sha256 2>/dev/null || true
  cb_out=$(bash tools/check-baseline.sh --update 2>&1); cb_rc=$?
  printf '%s\n' "$cb_out" | tail -2
  if [ "$cb_rc" != 0 ]; then echo "⛔ 资产基线重记失败（rc=$cb_rc）⇒ 拒绝提交：不许把'基线没更新'悄悄带进去" >&2; exit 1; fi
  git add tools/baseline.sha256
fi
exit 0
