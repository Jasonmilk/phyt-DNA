#!/usr/bin/env bash
# pre-commit —— 【改完即重生】：闸门资产一变，就自动重生 INDEX / 引擎清单 / 资产基线。
#
# ★ 为什么存在（reviewer ③ · 2026-10-11）：一致性检查在 CI 层（事后），而 pre-commit 层是空的
#   ⇒ 同一个坑踩了两次。**同坑两次不是粗心，是位置错** ⇒ 防线前移到事前：不依赖"记得"，改完即重生。
#
# ★ 2026-10-12 重写（园丁裁定 0）：原版有三处控制流病，导致**新增的阻断是不可达的死代码**：
#   ① 第 9 行 `cd … ||` 后面接了注释与 if ⇒ **`||` 短路掉整块 wip 判断**（永不执行）；
#   ② 第 26 行**无条件 `# ── ③ ci-local 门禁（2026-10-13 · 清单 1 ①）：**提交前必须 ci-local 绿** ─────────────
#   ★ 为什么在钩子里跑它（而不是再写一套）：`ci-local` 里就有【全仓扫描 + spec-lint + 心跳 + 基线】
#     ⇒ 钩子与 CI **同款**（这是"断言面移到提交之前"的唯一可靠形态：不是"我记得跑"，是"跑不过就不许提交"）。
#   ★ [wip]/PHYT_WIP 逃生门只跳这一步（中间态提交需要它），重生照做、CI 兜底。
if [ "${WIP:-0}" = 0 ]; then
  ci_out=$(bash tools/ci-local.sh 2>&1); ci_rc=$?
  if [ "$ci_rc" != 0 ]; then
    echo "⛔ ci-local 未全绿 ⇒ 拒绝提交（红不许溜出本机；这正是第八/九次红着推的根因）" >&2
    printf '%s\n' "$ci_out" | grep -E '★ RED|CI-LOCAL|违规' | head -6 | sed 's/^/   /' >&2
    exit 1
  fi
  echo "  [pre-commit] ci-local 全绿（扫描 + spec-lint + 心跳 + 基线 —— 与 CI 同款）"
fi
exit 0`** ⇒ 其后的重生/阻断**全是死代码**（"死判据"家族第 9 例）；
#   ③ 其后一个 `if/else` 缺 `fi`。
#   ⇒ 现在：**无早退、无死代码**；逃生门（[wip]）只跳【扫描】、**保留【重生】**。
set -uo pipefail
ROOT=$(git rev-parse --show-toplevel) || { echo "⛔ 不在 git 工作区 ⇒ 拒绝提交" >&2; exit 1; }
cd "$ROOT" || exit 1

# ★ 2026-10-12（实测缺陷修复）：**git 在 pre-commit 阶段拿不到【待写】的消息** ⇒ 原来"读上一笔提交"的 [wip] 判定
#   **形同虚设**（我的"验收 C-clean [wip]"就被它漏判、由扫描步拒了）。⇒ 正式逃生门改为**环境变量**：
#     `PHYT_WIP=1 git commit -m "…"`（消息里的 [wip] 仍兼容，但它只能反映【上一笔】）。
WIP=0
[ "${PHYT_WIP:-0}" = 1 ] && WIP=1
case "$(git log -1 --pretty=%s 2>/dev/null || true)" in *'[wip]'*) WIP=1 ;; esac

# ── ① 扫描（timing:post）· 仅非 [wip]（[wip] 的逃生门只跳这一步）────────────────
if [ "$WIP" = 0 ]; then
  viol=0
  for f in $(git diff --cached --name-only | grep -E '\.(md|sh|py|ya?ml)$' || true); do
    [ -f "$f" ] || continue
    printf '{"tool":"Write","paths":["%s"]}\n' "$f" | bash tools/validate.sh --timing post > /tmp/.hookscan.$$ 2>&1
    if [ $? = 2 ]; then grep -m1 '违规' /tmp/.hookscan.$$ | sed 's/^/  ★ 违规: /'; viol=1; fi
  done

  if [ "$viol" = 1 ]; then echo "  ⇒ step 4 扫描有违规 ⇒ 拒绝提交（防线前移到事前）" >&2; exit 1; fi
else
  echo "  [pre-commit] 提交信息含 [wip] ⇒ 跳过 step-4 扫描（**仍重生** INDEX/清单/基线；CI 兜底）"
fi

# ── ② 重生（**[wip] 也要做**）· 任何一步失败 ⇒ 阻断（把红挡在本机）─────────────
idx_out=$(bash tools/validate.sh --index 2>&1); idx_rc=$?
if [ "$idx_rc" != 0 ]; then echo "⛔ INDEX 重生失败 ⇒ 拒绝提交: $(printf '%s' "$idx_out" | tail -1)" >&2; exit 1; fi
if ! printf '%s' "$idx_out" | cmp -s - decisions/INDEX.md 2>/dev/null; then
  printf '%s' "$idx_out" > decisions/INDEX.md; git add decisions/INDEX.md
  echo "  [pre-commit] 闸门资产变了 ⇒ decisions/INDEX.md 已自动重生（不依赖记得）"
fi

# ★ 1（2026-10-12 园丁裁定）：**按 staged 判定是错的** —— 改 `docs/*.md` 同样会动资产，
#   而那条正则只认 decisions/|tools/|DNA.md ⇒ **"该跑的时候没跑"**（实测：改 docs/ 动资产，钩子放行）。
#   ⇒ 改为【无条件重算 + 比对】：重算 ≡ 已提交版 ? pass : **拒绝并提示 --update**（基线不许"下一笔补"）。
um_out=$(bash tools/upstream-manifest.sh --write 2>&1); um_rc=$?
if [ "$um_rc" != 0 ]; then echo "⛔ 引擎清单重生失败 ⇒ 拒绝提交: $(printf '%s' "$um_out" | tail -1)" >&2; exit 1; fi
# ★ 2026-10-12（自伤修复）：**不许静默吞码** —— 原为 `# ★ 2026-10-12（自伤修复 · 全链条）：**清单真名是 `tools/UPSTREAM.sha256`**（我原先写的 `upstream-manifest.sha256` 不存在）
#   而 `git add … 2>/dev/null || true` 把"名字错了"**静默吞掉** ⇒ **清单从未被带进提交** ⇒ ci-local step 0 反复红、我反复推。
#   ⇒ 用真名 + **不许吞码** + 重生后仍有未暂存差异即拒绝。
git add tools/UPSTREAM.sha256
if ! git diff --cached --quiet -- tools/UPSTREAM.sha256; then
  echo "  [pre-commit] 引擎清单已同批重生并纳入提交"
fi
# ★ 1（裁定统一）：清单与基线一律【自动 add】（不拒绝）—— 拒绝会造成"人工补一步"，今晚我栽过五次；
#   兜底交给 CI（ci-local step 0/1 会独立校验）。rc 铁律保留（重生失败仍然阻断）。
if ! git diff --quiet -- tools/UPSTREAM.sha256; then git add tools/UPSTREAM.sha256; fi
cb_out=$(bash tools/check-baseline.sh --update 2>&1); cb_rc=$?
printf '%s\n' "$cb_out" | tail -1
if [ "$cb_rc" != 0 ]; then echo "⛔ 资产基线重算失败（rc=$cb_rc）⇒ 拒绝提交" >&2; exit 1; fi
# ★ 1（2026-10-12 裁定 · 我倾向并采用【前者】）：**自动 add + CI 校验兜底** —— 不要"人工补一步"。
#   理由（有实测）：今晚我**五次**栽在"要人工补一步"（基线/清单都是）。**由机制替手，CI 兜底**。
if ! git diff --quiet -- tools/baseline.sha256; then
  git add tools/baseline.sha256
  echo "  [pre-commit] 资产基线已同批重算并纳入提交（自动；CI 兜底校验）"
fi
exit 0
