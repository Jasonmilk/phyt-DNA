#!/usr/bin/env bash
# pre-commit —— 【改完即重生】：闸门资产一变，就自动重生 INDEX 与基线。
#
# ★ 为什么存在（reviewer ③ · 2026-10-11）：INDEX 的一致性检查在 **CI 层（事后）**，
#   而 **pre-commit 层是空的** ⇒ 同一个坑我踩了两次（改了闸门资产却忘重生 INDEX）。
#   **同坑两次不是粗心，是位置错**：投资阶梯已到结晶线，缺的是【位置】不是数量。
#   ⇒ 把防线**前移到事前**：不依赖"记得"，改完即重生。
set -uo pipefail
cd "$(git rev-parse --show-toplevel)" || # ㊂ 逃生门（reviewer ③）：中间态提交（ADR 先行·夹具后补）需要旁路。
#   `--no-verify` 是霰弹枪（连 INDEX 重生一起杀）⇒ 用 [wip] 只跳【扫描】、保留【重生】。CI 兜底。
if git log -1 --pretty=%s 2>/dev/null | grep -q '\[wip\]'; then
  echo "  [pre-commit] 提交信息含 [wip] ⇒ 跳过 step-4 扫描（保留 INDEX/基线重生；CI 兜底）"
  exit 0
fi

# ★ 防线前移（reviewer ③/④ · 2026-10-11）：只重生 INDEX/基线**不够** —— 我因【不跑 step 4】把一条
#   `$var（` 违规放进了提交。⇒ 钩子对**本次暂存的文本文件**跑一次 timing:post 扫描；红则不提交。
viol=0
for f in $(git diff --cached --name-only | grep -E '\.(md|sh|py|ya?ml)$' || true); do
  [ -f "$f" ] || continue
  printf '{"tool":"Write","paths":["%s"]}\n' "$f" | bash tools/validate.sh --timing post >/tmp/.hookscan.$$ 2>&1
  if [ $? = 2 ]; then grep -m1 '违规' /tmp/.hookscan.$$ | sed 's/^/  ★ 违规: /'; viol=1; fi
done
rm -f /tmp/.hookscan.$$
if [ "$viol" = 1 ]; then echo "  ⇒ step 4 扫描有违规 ⇒ 拒绝提交（防线前移到事前）" >&2; exit 1; fi
exit 0
staged=$(git diff --cached --name-only 2>/dev/null | grep -E '^(decisions/|tools/|DNA\.md)' || true)
[ -z "$staged" ] && exit 0
changed=0
if ! bash tools/validate.sh --index > /tmp/.idx.$$ 2>/dev/null; then rm -f /tmp/.idx.$$; exit 0; fi
if ! cmp -s /tmp/.idx.$$ decisions/INDEX.md 2>/dev/null; then mv /tmp/.idx.$$ decisions/INDEX.md; git add decisions/INDEX.md; changed=1; else rm -f /tmp/.idx.$$; fi
if bash tools/check-baseline.sh --update >/dev/null 2>&1; then git add tools/baseline.sha256 2>/dev/null || true; fi
[ "$changed" = 1 ] && echo "  [pre-commit] 闸门资产变了 ⇒ decisions/INDEX.md 已自动重生（不依赖记得）"
exit 0
