#!/usr/bin/env bash
# pre-commit —— 【改完即重生】+【提交前门禁】。
#
# ★ 为什么存在（reviewer ③ · 2026-10-11）：一致性检查在 CI 层（事后），而 pre-commit 层是空的
#   ⇒ 同一个坑踩了两次。**同坑两次不是粗心，是位置错** ⇒ 防线前移到事前：不依赖"记得"，改完即重生。
# ★ 2026-10-13（清单 1 ①）：**提交前必须 ci-local 绿** —— 这是第八/九次红着推的根因（断言面在提交之后）。
#   为什么在钩子里跑它而不是另写一套：`ci-local` 里就有【全仓扫描 + spec-lint + 心跳 + 基线】⇒ 钩子与 CI **同款**。
#   逃生门：`PHYT_WIP=1`（或上一笔消息含 [wip]）只跳门禁，**重生照做、CI 兜底**。
#
# 顺序即语义（我在这里栽过）：① 定位 → ② 读逃生门 → ③ 重生 → ④ 门禁 → ⑤ 放行。
set -uo pipefail
if ! ROOT=$(git rev-parse --show-toplevel); then
  echo "⛔ 不在 git 工作区 ⇒ 拒绝提交" >&2
  exit 1
fi
cd "$ROOT" || exit 1

# ── ② 逃生门（PHYT_WIP=1 优先；消息里的 [wip] 只能反映【上一笔】—— git 在 pre-commit 看不到待写消息）
WIP=0
# ── ★ 逃生门护栏（清单 1 ① · 2026-10-13）：**只在【门自身坏了】时放行**；内容违规仍然拒 ──
#   ① 理由来自机器（哪一步红 + 首条消息），不是我敲的一句话；
#   ② 作用域 = 门自身（spec-lint/清点器/死代码断言坏了 ⇒ 放行；step 4 扫描违规 / 基线红 ⇒ **拒**）；
#   ③ 落账（ledger 一行 kind=skip，机器可读）· ④ 计数（`kind=skip` 的条数）· ⑤ 不计入"连续无红推轮数 N"。
if [ "${PHYT_WIP:-0}" = 1 ]; then
  pre=$(bash tools/ci-local.sh 2>&1); pre_rc=$?
  if [ "$pre_rc" = 0 ]; then
    echo "  [pre-commit] 逃生门未被使用（ci-local 本来就绿）"
  else
    step=$(printf '%s\n' "$pre" | grep -E '★ RED' -B1 | grep -E '^  [0-9]' | head -1 | sed 's/^ *//')
    if printf '%s\n' "$pre" | grep -qE '全仓违规扫描|违规:'; then
      echo "⛔ 内容违规（**不是门坏了**）⇒ 逃生门不适用（PHYT_WIP 只对'门自身坏'有效）" >&2
      printf '%s\n' "$pre" | grep -E '违规' | head -3 | sed 's/^/   /' >&2
      exit 1
    fi
    echo "  [pre-commit] 逃生门放行 —— 理由（机器给出）: ${step:-（未取到步骤名）}"
    python3 -c 'import json,sys,time;print(json.dumps({"ts":time.strftime("%Y-%m-%dT%H:%M:%S%z"),"kind":"skip","gate_id":"pre-commit-gate","verdict":"skip","override":True,"source":"hook","event_id":"wip-escape-%d"%int(time.time()),"note":"PHYT_WIP 逃生门：%s" % sys.argv[1][:200]},ensure_ascii=False))' "${step:-unknown}" >> "ledger/hits-$(date +%Y).jsonl"
    echo "  [pre-commit] 已落账（kind=skip，不计入连续无红推轮数 N）"
  fi
  WIP=1
fi
case "$(git log -1 --pretty=%s 2>/dev/null || true)" in *'[wip]'*) WIP=1 ;; esac
if [ "$WIP" = 1 ]; then
  echo "  [pre-commit] 逃生门（PHYT_WIP=1 或上一笔含 [wip]）⇒ 跳过门禁（**重生照做**；CI 兜底）"
fi

# ── ③ 重生（[wip] 也要做）· 任何一步失败 ⇒ 阻断
idx_out=$(bash tools/validate.sh --index 2>&1); idx_rc=$?
if [ "$idx_rc" != 0 ]; then echo "⛔ INDEX 重生失败 ⇒ 拒绝提交: $(printf '%s' "$idx_out" | tail -1)" >&2; exit 1; fi
if ! printf '%s' "$idx_out" | cmp -s - decisions/INDEX.md 2>/dev/null; then
  printf '%s' "$idx_out" > decisions/INDEX.md; git add decisions/INDEX.md
  echo "  [pre-commit] INDEX 已自动重生（不依赖记得）"
fi
um_out=$(bash tools/upstream-manifest.sh --write 2>&1); um_rc=$?
if [ "$um_rc" != 0 ]; then echo "⛔ 引擎清单重生失败 ⇒ 拒绝提交: $(printf '%s' "$um_out" | tail -1)" >&2; exit 1; fi
git add tools/UPSTREAM.sha256
if ! git diff --quiet -- tools/UPSTREAM.sha256; then
  git add tools/UPSTREAM.sha256
fi
cb_out=$(bash tools/check-baseline.sh --update 2>&1); cb_rc=$?
if [ "$cb_rc" != 0 ]; then echo "⛔ 资产基线重算失败（rc=$cb_rc）⇒ 拒绝提交" >&2; exit 1; fi
if ! git diff --quiet -- tools/baseline.sha256; then
  git add tools/baseline.sha256
  echo "  [pre-commit] 资产基线已同批重算并纳入提交（自动；CI 兜底校验）"
fi

# ── ④ 门禁：ci-local（扫描 + spec-lint + 心跳 + 基线 —— 与 CI 同款）
if [ "$WIP" = 0 ]; then
  ci_out=$(bash tools/ci-local.sh 2>&1); ci_rc=$?
  if [ "$ci_rc" != 0 ]; then
    echo "⛔ ci-local 未全绿 ⇒ 拒绝提交（红不许溜出本机 —— 第八/九次红着推的根因）" >&2
    printf '%s\n' "$ci_out" | grep -E '★ RED|CI-LOCAL|违规' | head -6 | sed 's/^/   /' >&2
    exit 1
  fi
  echo "  [pre-commit] ci-local 全绿（扫描 + spec-lint + 心跳 + 基线 —— 与 CI 同款）"
fi
exit 0
